# Settings of your stand: copy this file to .env.local (ignored by git) and fill it in.
# Réglages de ton stand : copie ce fichier en .env.local (ignoré par git) et remplis-le.

# Trades shown on the welcome screen, in order (ids of src/trades/index.ts). Empty: all of them.
# With a single trade, the visitor doesn't get to choose.
VITE_TRADES=mediamatique

# Photo scan at the start of a game (true by default). false: visitors create their avatar by hand,
# with no consent card about photos. A trade can also turn it off for itself (scan: false in its module).
VITE_SCAN=true

# Your school, in the footer of the posters and of the printed « Dans les coulisses ».
# Its logo goes in public/school/logo.svg (or the name is written instead).
# Leave VITE_SCHOOL_URL empty to have no school footer.
VITE_SCHOOL_NAME=
VITE_SCHOOL_SITE=
VITE_SCHOOL_URL=
